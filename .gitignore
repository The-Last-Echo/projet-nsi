# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (one per developer)
.venv/
venv/
env/

# Python packaging and build output
build/
dist/
*.egg-info/

# Test and quality-tool caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDEs (keep shared VS Code extension recommendations)
.idea/
.vscode/*
!.vscode/extensions.json

# Operating systems
.DS_Store
Thumbs.db

# Local environment variables and secrets
.env
.env.*
!.env.example
